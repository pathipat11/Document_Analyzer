DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1

# Comma separated list of allowed hosts (required when DJANGO_DEBUG=0)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Comma separated list of trusted origins for CSRF (e.g. https://yourdomain.com)
CSRF_TRUSTED_ORIGINS=
# Redirect all HTTP to HTTPS in production (1/0). Disable if TLS is terminated upstream.
SECURE_SSL_REDIRECT=1

DB_NAME=document_analyzer
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

MAX_UPLOAD_SIZE=5242880
MAX_FILES_PER_UPLOAD=5
MAX_TOTAL_UPLOAD_SIZE=20971520
ALLOWED_EXTENSIONS=txt,csv,pdf,docx

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:latest
ENABLE_LLM=1

# AWS Credebtials
# --- Bedrock ---
LLM_PROVIDER=bedrock
AWS_REGION=us-east-1

# Inference profile ARN
BEDROCK_INFERENCE_PROFILE_ARN=arn:xxxx

# optional tuning
BEDROCK_MAX_TOKENS=800
BEDROCK_TEMPERATURE=0.2

LLM_DAILY_CALL_LIMIT=5

LLM_TOKENS_CHAT=50000
LLM_TOKENS_UPLOAD=100000

# --- S3 Storage ---
AWS_STORAGE_BUCKET_NAME=xxx
AWS_S3_REGION_NAME=us-east-1

# --- Cache ---
# Required in production so LLM quotas/guardrails are shared across workers.
# If unset, falls back to per-process in-memory cache (dev only).
# REDIS_URL=redis://127.0.0.1:6379/1

# --- Async processing (Celery) ---
# Set to 1 to process uploads/reprocessing in a background worker.
# Requires a running broker and a worker:
#   celery -A config worker -l info
PROCESS_DOCUMENTS_ASYNC=0
# Broker/result backend. Defaults to REDIS_URL or redis://127.0.0.1:6379/0
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

EMAIL_HOST_USER=your-email
EMAIL_HOST_PASSWORD=your-email-password

SITE_DOMAIN=127.0.0.1:8000
SITE_PROTOCOL=http

# you can get password for app, when you create success you pull password to "EMAIL_HOST_PASSWORD" 
# Toturial : https://support.google.com/accounts/answer/185833?h
